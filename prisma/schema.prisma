generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CASH
  BANK
  CREDIT_CARD
  INVESTMENT
}

enum TransactionKind {
  INCOME
  EXPENSE
}

// Cómo se pagó un gasto. Es informativo: el saldo lo mueve la cuenta
// (ej. un Yape o una compra con tarjeta que sale de la cuenta sueldo).
enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  YAPE
  PLIN
  CASH
  TRANSFER
}

// Servicio o gasto programado (al pagarlo se registra un gasto) o pago de
// tarjeta de crédito (recordatorio: sus gastos ya están registrados).
enum ScheduledPaymentType {
  BILL
  CREDIT_CARD
}

enum ScheduleFrequency {
  ONCE
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum OccurrenceStatus {
  PAID
  SKIPPED
}

enum BudgetTemplate {
  PARTY
  EVENT
  CONSTRUCTION
  TRIP
  SHOPPING
  BLANK
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  initialBalance Decimal     @default(0) @db.Decimal(12, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transactions      Transaction[]
  budgets           Budget[]
  scheduledPayments ScheduledPayment[]

  @@index([userId])
}

model Category {
  id        String          @id @default(cuid())
  userId    String?
  name      String
  kind      TransactionKind
  icon      String?
  createdAt DateTime        @default(now())

  transactions      Transaction[]
  budgetItems       BudgetItem[]
  reasons           CategoryReason[]
  scheduledPayments ScheduledPayment[]

  @@unique([userId, name, kind])
  @@index([userId])
}

// Motivo sugerido para una categoría. Sirve para escribir siempre igual los
// gastos que se repiten. Como en Category, userId null = predefinido.
model CategoryReason {
  id         String   @id @default(cuid())
  userId     String?
  categoryId String
  name       String
  createdAt  DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, name])
  @@index([categoryId])
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  accountId     String
  categoryId    String
  kind          TransactionKind
  amount        Decimal         @db.Decimal(12, 2)
  // Para qué fue (ej. "Almuerzo"). Sale de sugerencias por categoría y agrupa
  // los gastos recurrentes. `description` queda como nota en texto libre.
  reason        String?
  description   String?
  date          DateTime
  // Solo gastos. Null en ingresos y en gastos anteriores a este campo.
  paymentMethod PaymentMethod?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryId], references: [id])
  budgetItem          BudgetItem?
  scheduledOccurrence ScheduledOccurrence?
  rouletteOperation   RouletteOperation?

  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
}

// Presupuesto para algo que todavía no pasó (una fiesta, una obra, unas
// compras). Sus líneas son gastos planificados que se "aplican" creando una
// Transaction real.
model Budget {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String?
  // Día calendario del evento, guardado como medianoche UTC (igual que Transaction.date).
  date        DateTime?
  template    BudgetTemplate @default(BLANK)
  // Cuenta propuesta al aplicar gastos; se puede cambiar en cada aplicación.
  accountId   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  account Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  items   BudgetItem[]

  @@index([userId])
}

model BudgetItem {
  id            String   @id @default(cuid())
  budgetId      String
  categoryId    String
  description   String
  // Cantidad × precio unitario es opcional; si están, amount = quantity * unitPrice.
  quantity      Decimal? @db.Decimal(10, 2)
  unitPrice     Decimal? @db.Decimal(12, 2)
  // Monto planificado. El monto real queda en la Transaction aplicada.
  amount        Decimal  @default(0) @db.Decimal(12, 2)
  // Gasto generado al aplicar. Si se borra el gasto, la línea vuelve a pendiente.
  transactionId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  budget      Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([budgetId])
  @@index([categoryId])
}

// Pago que se repite (o uno puntual) para el calendario. Las cuotas se calculan
// con la regla (startDate + frequency); no se guardan hasta pagarlas u omitirlas.
model ScheduledPayment {
  id            String               @id @default(cuid())
  userId        String
  type          ScheduledPaymentType @default(BILL)
  // En BILL también es el motivo del gasto que se registra al pagar.
  name          String
  // Obligatoria en BILL; la tarjeta no registra gasto.
  categoryId    String?
  // Cuenta y método propuestos al pagar; se pueden cambiar en cada pago.
  accountId     String?
  paymentMethod PaymentMethod?
  // Monto estimado. En tarjeta es null: se estima con los gastos del ciclo.
  amount        Decimal?             @db.Decimal(12, 2)
  frequency     ScheduleFrequency    @default(MONTHLY)
  // Primera fecha, como medianoche UTC. Su día del mes es el día de pago.
  startDate     DateTime
  endDate       DateTime?
  // Solo tarjeta: días de cierre y de pago de la regla. Se usan para los meses
  // que no están en el cronograma (CardBillingPeriod).
  closingDay    Int?
  dueDay        Int?
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  account            Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category           Category?             @relation(fields: [categoryId], references: [id])
  occurrences        ScheduledOccurrence[]
  statements         CardStatement[]
  rouletteOperations RouletteOperation[]
  billingPeriods     CardBillingPeriod[]

  @@index([userId])
}

// Una cuota ya resuelta (pagada u omitida). Si se borra el gasto generado, la
// cuota se borra con él y vuelve a quedar pendiente.
model ScheduledOccurrence {
  id                 String           @id @default(cuid())
  scheduledPaymentId String
  // Fecha de vencimiento de la regla (no la fecha en que se pagó).
  dueDate            DateTime
  status             OccurrenceStatus
  // Monto pagado. En BILL coincide con el de la Transaction.
  amount             Decimal?         @db.Decimal(12, 2)
  transactionId      String?          @unique
  createdAt          DateTime         @default(now())

  scheduledPayment ScheduledPayment @relation(fields: [scheduledPaymentId], references: [id], onDelete: Cascade)
  transaction      Transaction?     @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([scheduledPaymentId, dueDate])
}

// Deuda del estado de cuenta en un vencimiento de tarjeta. Si no se ingresó,
// el calendario usa el estimado con los gastos con tarjeta del ciclo.
model CardStatement {
  id                 String   @id @default(cuid())
  scheduledPaymentId String
  dueDate            DateTime
  amount             Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  scheduledPayment ScheduledPayment @relation(fields: [scheduledPaymentId], references: [id], onDelete: Cascade)

  @@unique([scheduledPaymentId, dueDate])
}

// Un "micro ruleteo" para pagar la tarjeta: se cargan `charge` a la tarjeta en
// un proveedor que deposita charge − fee. Al registrarlo, la comisión se
// guarda como gasto; si se borra ese gasto, vuelve a planificado.
model RouletteOperation {
  id                 String   @id @default(cuid())
  userId             String
  // Vencimiento de tarjeta que ayuda a cubrir (misma clave que las cuotas).
  scheduledPaymentId String
  dueDate            DateTime
  // Día en que se hace, como medianoche UTC.
  date               DateTime
  provider           String
  // 0.0200 = 2 %.
  feeRate            Decimal  @db.Decimal(6, 4)
  charge             Decimal  @db.Decimal(12, 2)
  // charge × feeRate, redondeado a céntimos.
  fee                Decimal  @db.Decimal(12, 2)
  transactionId      String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  scheduledPayment ScheduledPayment @relation(fields: [scheduledPaymentId], references: [id], onDelete: Cascade)
  transaction      Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([scheduledPaymentId, dueDate])
}

// Un mes del cronograma de facturación que publica el banco: cierre y pago
// exactos (el banco los mueve a días hábiles). El mes de facturación es el del
// cierre. Los meses sin fila usan la regla closingDay / dueDay.
model CardBillingPeriod {
  id                 String   @id @default(cuid())
  scheduledPaymentId String
  // Día 1 del mes de facturación, medianoche UTC.
  month              DateTime
  closingDate        DateTime
  dueDate            DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  scheduledPayment ScheduledPayment @relation(fields: [scheduledPaymentId], references: [id], onDelete: Cascade)

  @@unique([scheduledPaymentId, month])
  @@unique([scheduledPaymentId, dueDate])
}
